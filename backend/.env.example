APP_NAME="HRM Indonesia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Frontend SPA. Pakai nama host yang SAMA untuk frontend dan API (jangan campur localhost dan 127.0.0.1).
# Nilai ini menggantikan seluruh daftar bawaan Sanctum, jadi host API ikut ditulis.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,localhost:8000,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Batas baris untuk ekspor CSV laporan.
HRM_REPORT_MAX_EXPORT_ROWS=5000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Produksi (contoh, sesuaikan alamat Anda) ---
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_URL=https://api.hrm.contoh.co.id
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=hrm.contoh.co.id,api.hrm.contoh.co.id
# CORS_ALLOWED_ORIGINS=https://hrm.contoh.co.id
